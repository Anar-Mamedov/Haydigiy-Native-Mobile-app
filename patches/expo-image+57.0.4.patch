+package expo.modules.image
+
+import java.util.Collections
+import java.util.WeakHashMap
+
+/**
+ * Keeps track of the image views that are alive, so app-wide memory events can reach them.
+ * Views are held weakly; a view that is never unregistered doesn't leak.
+ */
+internal object ExpoImageViewRegistry {
+  private val views: MutableSet<ExpoImageViewWrapper> = Collections.newSetFromMap(WeakHashMap())
+
+  fun register(view: ExpoImageViewWrapper) = synchronized(views) {
+    views.add(view)
+  }
+
+  fun unregister(view: ExpoImageViewWrapper) = synchronized(views) {
+    views.remove(view)
+  }
+
+  fun forEach(action: (ExpoImageViewWrapper) -> Unit) {
+    // Iterates over a copy, because the action may cause views to be registered or unregistered.
+    val snapshot = synchronized(views) { views.toList() }
+    snapshot.forEach(action)
+  }
+}
