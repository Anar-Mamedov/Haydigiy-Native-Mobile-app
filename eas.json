{
  "cli": {
    "version": ">= 16.20.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "environment": "development",
      "env": {
        "EXPO_NO_CAPABILITY_SYNC": "1",
        "INSIDER_APNS_MODE": "development"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview",
      "env": {
        "EXPO_NO_CAPABILITY_SYNC": "1",
        "INSIDER_APNS_MODE": "production"
      }
    },
    "preview-apk": {
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview",
      "env": {
        "EXPO_NO_CAPABILITY_SYNC": "1",
        "INSIDER_APNS_MODE": "production"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "distribution": "store",
      "channel": "production",
      "environment": "production",
      "env": {
        "EXPO_NO_CAPABILITY_SYNC": "1",
        "INSIDER_APNS_MODE": "production"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6450927928"
      }
    }
  }
}
